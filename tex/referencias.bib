@article{autoHistImg,
	title = {Automated classification of histopathology images using
	         transfer learning},
	journal = {Artificial Intelligence in Medicine},
	volume = {101},
	pages = {101743},
	year = {2019},
	issn = {0933-3657},
	doi = {https://doi.org/10.1016/j.artmed.2019.101743},
	url = {
	       https://www.sciencedirect.com/science/article/pii/S0933365719307110
	       },
	author = {Muhammed Talo},
	keywords = {Medical image classification, Histopathology, Deep learning,
	            Transfer learning, CNN},
	abstract = {Early and accurate diagnosis of diseases can often save
	            lives. Diagnosis of diseases from tissue samples is done
	            manually by pathologists. Diagnostics process is usually time
	            consuming and expensive. Hence, automated analysis of tissue
	            samples from histopathology images has critical importance
	            for early diagnosis and treatment. The computer aided systems
	            can improve the quality of diagnoses and give pathologists a
	            second opinion for critical cases. In this study, a deep
	            learning based transfer learning approach has been proposed
	            to classify histopathology images automatically. Two
	            well-known and current pre-trained convolutional neural
	            network (CNN) models, ResNet-50 and DenseNet-161, have been
	            trained and tested using color and grayscale images. The
	            DenseNet-161 tested on grayscale images and obtained the best
	            classification accuracy of 97.89%. Additionally, ResNet-50
	            pre-trained model was tested on the color images of the Kimia
	            Path24 dataset and achieved the highest classification
	            accuracy of 98.87%. According to the obtained results, it may
	            be said that the proposed pre-trained models can be used for
	            fast and accurate classification of histopathology images and
	            assist pathologists in their daily clinical tasks.},
}

@article{histImgColorectal,
	title = {Histopathology image analysis for colorectal cancer using deep
	         learning techniques: A comprehensive survey},
	journal = {Engineering Applications of Artificial Intelligence},
	volume = {172},
	pages = {114262},
	year = {2026},
	issn = {0952-1976},
	doi = {https://doi.org/10.1016/j.engappai.2026.114262},
	url = {
	       https://www.sciencedirect.com/science/article/pii/S0952197626005439
	       },
	author = {Sanjeev Kumar and Pramod Kumar Mishra},
	keywords = {Colorectal cancer, Classification, Deep learning,
	            Histopathology images, Machine learning, Post-processing,
	            Pre-processing, Prediction, Segmentation, Whole slide imaging
	            },
	abstract = {Histopathology images are considered the benchmark modality
	            for the definitive diagnosis of colorectal cancer owing to
	            their ability to extract rich phenotypic information.
	            Nowadays, histopathology images are acquired and digitalized
	            using Whole Slide Image scanners. This shift enables the
	            integration of machine learning and deep learning into the
	            pathological workflow and opens a new avenue for
	            computational pathology. A typical workflow of computational
	            pathology for colorectal cancer can be formulated as a
	            three-phase pipeline: pre-processing, analysis, and
	            post-processing. However, critical examination of the
	            existing studies has primarily centered on the analysis phase
	            due to the widespread use of curated datasets. Consequently,
	            pre-processing and post-processing stages are often
	            overlooked. This methodological bias leads to a fragmented
	            research pipeline, limiting the generalizability required to
	            handle real-world clinical practice. The survey showcases a
	            three-phase pipeline that unifies approaches across
	            pre-processing, image analysis, and post-processing methods.
	            In the first stage, an overview of methods for effectively
	            preparing histopathological images through pre-processing is
	            presented. The second phase surveys recent developments in
	            computational models for tissue classification, segmentation,
	            detection, and biomarker prediction. Finally, this review
	            presents techniques used in colorectal cancer histopathology
	            to enhance network output by post-processing. In addition,
	            existing open issues and future research directions are
	            discussed for innovative researchers. By consolidating the
	            findings of several studies, this review underscores the
	            pressing need for a unified approach that effectively bridges
	            the gap between current research and clinical acceptance.},
}

